<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#132030;
    --navy:#1c2e45;
    --paper:#ffffff;
    --panel:#f4f6f8;
    --line:#e1e5ea;
    --muted:#5b6773;
    --teal:#2c6e63;
    --teal-deep:#204f47;
  }
  :root:not([data-theme="light"]) { }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ink:#e7ebef; --navy:#dbe4ee; --paper:#10161f; --panel:#161d27;
      --line:#2a333f; --muted:#9aa6b2; --teal:#57b6a4; --teal-deep:#6fd0bd;
    }
  }
  :root[data-theme="dark"]{
    --ink:#e7ebef; --navy:#dbe4ee; --paper:#10161f; --panel:#161d27;
    --line:#2a333f; --muted:#9aa6b2; --teal:#57b6a4; --teal-deep:#6fd0bd;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth; scroll-padding-top:calc(76px + env(safe-area-inset-top,0px));}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:'Inter',sans-serif; line-height:1.6;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  h1,h2,h3{font-family:'Source Serif 4',serif; font-weight:600; margin:0; color:var(--navy);}
  a{color:inherit;}
  .wrap{max-width:760px; margin:0 auto; padding:0 28px;}

  header.site{
    position:sticky; top:0; z-index:10;
    background:color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
    padding-top:env(safe-area-inset-top,0px);
  }
  .nav{display:flex; align-items:center; justify-content:space-between; padding:16px 28px; max-width:760px; margin:0 auto;}
  .nav .name{font-family:'Source Serif 4',serif; font-weight:600; font-size:1.05rem; color:var(--navy);}
  .nav ul{list-style:none; display:flex; gap:22px; margin:0; padding:0;}
  .nav a{text-decoration:none; font-size:0.92rem; color:var(--muted); transition:color .15s;}
  .nav a:hover{color:var(--teal-deep);}

  section{padding:72px 0;}
  section + section{border-top:1px solid var(--line);}

  .hero{padding-top:88px; padding-bottom:80px;}
  .hero .role{color:var(--teal-deep); font-size:1.05rem; margin-bottom:14px;}
  .hero h1{font-size:2.6rem; line-height:1.15; max-width:14ch;}
  .hero p.lede{margin-top:22px; max-width:52ch; color:var(--muted); font-size:1.08rem;}
  .hero .actions{margin-top:32px; display:flex; gap:14px; flex-wrap:wrap;}
  .btn{
    display:inline-block; padding:11px 22px; border-radius:2px;
    text-decoration:none; font-size:0.95rem; font-weight:500;
    border:1px solid var(--navy); color:var(--navy);
    transition:background .15s, color .15s;
  }
  .btn.primary{background:var(--navy); color:var(--paper); border-color:var(--navy);}
  .btn.primary:hover{background:var(--teal-deep); border-color:var(--teal-deep);}
  .btn:not(.primary):hover{background:var(--panel);}

  h2.section-title{font-size:1.55rem; margin-bottom:28px;}

  .about p{max-width:60ch; color:var(--ink);}
  .about p + p{margin-top:16px;}

  .edu-item{display:grid; grid-template-columns:1fr; gap:4px; padding:18px 0; border-top:1px solid var(--line);}
  .edu-item:first-of-type{border-top:none;}
  .edu-item .row{display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap;}
  .edu-item .degree{font-weight:600; color:var(--navy);}
  .edu-item .when{color:var(--muted); font-size:0.92rem; white-space:nowrap;}
  .edu-item .school{color:var(--muted); font-size:0.95rem;}

  .skills-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:28px 32px;}
  .skills-grid h3{font-size:0.95rem; font-family:'Inter',sans-serif; font-weight:600; color:var(--teal-deep); margin-bottom:10px;}
  .skills-grid ul{margin:0; padding:0; list-style:none; color:var(--muted); font-size:0.95rem;}
  .skills-grid li{padding:4px 0;}

  .projects{display:flex; flex-direction:column; gap:22px;}
  .project{border:1px solid var(--line); border-radius:2px; padding:22px 24px; background:var(--panel);}
  .project h3{font-family:'Inter',sans-serif; font-size:1.05rem; font-weight:600; margin-bottom:8px; color:var(--navy);}
  .project p{margin:0; color:var(--muted); font-size:0.95rem;}
  .project .tags{margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;}
  .project .tags span{font-size:0.78rem; color:var(--teal-deep); border:1px solid var(--line); padding:3px 9px; border-radius:2px;}

  .contact p{max-width:52ch; color:var(--muted);}
  .contact-list{margin-top:24px; display:flex; flex-direction:column; gap:10px;}
  .contact-list a{text-decoration:none; color:var(--navy); font-weight:500; border-bottom:1px solid var(--line); padding-bottom:2px;}
  .contact-list a:hover{color:var(--teal-deep); border-color:var(--teal-deep);}

  footer{padding:32px 0; color:var(--muted); font-size:0.85rem;}

  @media (max-width:620px){
    .nav ul{gap:14px;}
    .hero h1{font-size:2.1rem;}
    .skills-grid{grid-template-columns:1fr;}
  }
</style>
</head>
